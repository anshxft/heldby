# Copy to web/.env.local (app) or contracts/.env (deploy) and fill in. Never commit real values.

# --- web: AI agent (server-only) ---
# Groq API key from https://console.groq.com/keys
GROQ_API_KEY=
# Private key of the arbiter wallet that signs resolve()
ARBITER_PRIVATE_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- contracts: deploy script ---
# Public address of the arbiter wallet
ARBITER=0x0000000000000000000000000000000000000000
# Deployer key lives in Foundry's encrypted keystore, not here:
#   cast wallet import deployer --interactive
